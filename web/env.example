# Copy to .env.local (git-ignored) and fill in.
# Local Docker database from db/docker-compose.yml:
DATABASE_URL=postgres://aina:aina-dev-only@localhost:5434/aina

# Neon (production): paste the POOLED connection string from the Neon dashboard. It contains "-pooler" in the host
# and ends with ?sslmode=require
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
